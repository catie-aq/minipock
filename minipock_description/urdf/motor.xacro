<?xml version="1.0"?>
<robot name="minipock" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Fixed visual of one roller, in the wheel link frame. The poses are the composition of the
       former roller joint origin and roller link visual origin. -->
  <xacro:macro name="roller_visual" params="xyz rpy">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <mesh filename="package://minipock_description/models/roller.stl" />
      </geometry>
      <material name="roller_material">
        <color rgba="0.14705882352941179736 0.14705882352941179736 0.14705882352941179736 1.0" />
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="motor"
    params="namespace:=minipock/ name:=motor_left x:=0.0 y:=0.0 z:=0.0
				       R:=0.0 P:=0.0 Y:=0.0 side:=1 mode:='differential'">

    <link name="${namespace}${name}_base_link">
      <visual>
        <origin xyz="0 0 0.0" rpy="${pi/2} 0 0" />
        <geometry>
          <mesh filename="package://minipock_description/models/wheel_base.dae" />
        </geometry>
      </visual>
      <inertial>
        <origin xyz="0.0 -0.029 0.0" rpy="0 0 0" />
        <mass value="1.587" />
        <inertia ixx="0.014" ixy="0.0" ixz="0.0" iyy="0.025" iyz="0.0" izz="0.013" />
      </inertial>
    </link>


    <xacro:if value="${mode == 'differential'}">
      <link name="${namespace}${name}_wheel_link">
        <visual>
          <origin xyz="0 0 -0.024" rpy="${pi/2} 0 0" />
          <geometry>
            <mesh filename="package://minipock_description/models/wheel_rotative.dae" />
          </geometry>
        </visual>
        <collision>
          <origin xyz="0 0.032 0.0" rpy="${pi/2} -0 0" />
          <geometry>
            <cylinder radius="0.0355" length="0.006" />
          </geometry>
        </collision>
        <inertial>
          <origin xyz="0.0 -0.029 0.0" rpy="0 -0 0" />
          <mass value="1.587" />
          <inertia ixx="0.014" ixy="0.0" ixz="0.0" iyy="0.025" iyz="0.0" izz="0.013" />
        </inertial>
      </link>
      <joint name="${namespace}${name}_wheel_joint" type="continuous">
        <parent link="${namespace}${name}_base_link" />
        <child link="${namespace}${name}_wheel_link" />
        <origin xyz="0.0 0.0 0.024" rpy="0 0 0" />
        <axis xyz="0 ${side} 0" />
        <limit effort="2000" velocity="45.5" />
      </joint>
    </xacro:if>

    <xacro:if value="${mode == 'holonomic'}">
      <!-- The wheel is a single rigid link. The rollers are kept as fixed visual geometry only:
           the base motion in simulation comes from the VelocityControl plugin, so they carry
           no kinematics. The collision is a cylinder of the firmware wheel radius. -->
      <link name="${namespace}${name}_wheel_link">
        <visual>
          <origin xyz="-4.8572257327350598644e-17 0 -0.0099999999999999793915"
            rpy="1.570796326794896558 -0 -3.8098343924097847915e-13" />
          <geometry>
            <mesh filename="package://minipock_description/models/wheel_core.stl" />
          </geometry>
          <material name="${namespace}${name}_wheel_link_material">
            <color
              rgba="0.06862745098039220171 0.08627450980392152857 0.05294117647058818044 1.0" />
          </material>
        </visual>
        <xacro:roller_visual xyz="-0.029520790 0.005342394 -0.005000000" rpy="0.000000000 1.570796327 1.396263402" />
        <xacro:roller_visual xyz="-0.026048262 -0.014883087 -0.005000000" rpy="0.000000000 1.570796327 2.094395102" />
        <xacro:roller_visual xyz="-0.010387463 -0.028144606 -0.005000000" rpy="0.000000000 1.570796327 2.792526803" />
        <xacro:roller_visual xyz="0.010133746 -0.028236951 -0.005000000" rpy="0.000000000 1.570796327 -2.792526803" />
        <xacro:roller_visual xyz="0.025913262 -0.015116913 -0.005000000" rpy="0.000000000 1.570796327 -2.094395102" />
        <xacro:roller_visual xyz="0.029567675 0.005076496 -0.005000000" rpy="0.000000000 1.570796327 -1.396263402" />
        <xacro:roller_visual xyz="0.019387044 0.022894557 -0.005000000" rpy="0.000000000 1.570796327 -0.698131701" />
        <xacro:roller_visual xyz="0.000135000 0.030000000 -0.005000000" rpy="0.000000000 1.570796327 -0.000000000" />
        <xacro:roller_visual xyz="-0.019387044 0.022894557 -0.005000000" rpy="0.000000000 1.570796327 0.698131701" />
        <collision>
          <origin xyz="0 0 -0.005" rpy="0 0 0" />
          <geometry>
            <cylinder radius="0.0355" length="0.016" />
          </geometry>
        </collision>
        <inertial>
          <origin
            xyz="-7.1267906557384964552e-06 -7.4554367595184111139e-06 -0.0074565222160878352753"
            rpy="0 0 0" />
          <mass value="0.0084406729050052354407" />
          <inertia ixx="1.6585465159980563238e-06" ixy="8.7787669783305516839e-10"
            ixz="-1.4548784474885956158e-10" iyy="1.6586259130583059041e-06"
            iyz="-1.5219483721075413049e-10" izz="3.2828932950195218582e-06" />
        </inertial>
      </link>
      <joint name="${namespace}${name}_wheel_joint" type="continuous">
        <parent link="${namespace}${name}_base_link" />
        <child link="${namespace}${name}_wheel_link" />
        <origin xyz="0.0 0.02 0.024" rpy="${pi/2} 0 0" />
        <axis xyz="0 0 ${side}" />
        <limit effort="2000" velocity="45.5" />
      </joint>
      <!-- The rollers let the real wheel slide freely along its axis: model it as frictionless,
           otherwise the cylinder collision drags the base against VelocityControl. -->
      <gazebo reference="${namespace}${name}_wheel_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
      </gazebo>
    </xacro:if>


    <joint name="${namespace}${name}_joint" type="fixed">
      <parent link="${namespace}base_link" />
      <child link="${namespace}${name}_base_link" />
      <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}" />
    </joint>


    <gazebo>
      <plugin filename="gz-sim-joint-controller-system"
        name="gz::sim::systems::JointController">
        <joint_name>${name}_wheel_joint</joint_name>
        <use_velocity_commands>true</use_velocity_commands>
        <topic>${namespace}${name}/pos</topic>
        <name>${name}</name>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
