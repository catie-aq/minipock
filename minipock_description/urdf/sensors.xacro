<?xml version="1.0"?>
<robot name="minipock" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- The gpu_lidar origin is inside the LD19 mesh, which would return the minimum range on every
       beam. The real LD19 does not see its own housing: in simulation, its visual carries one
       visibility bit per robot (bits 2 to 19, clear of the Gazebo GUI, selection and particle
       bits) and the LiDAR mask excludes that bit only, so each LiDAR still sees the other robots'
       LD19. `sim_index` must be unique per robot in a simulation. -->
  <xacro:macro name="lidar"
              params="namespace:=minipock/ name:=lidar x:=0.0 y:=0.0 z:=0.0 R:=0.0 P:=0.0 Y:=0.0
                      sim_index:=0">
    <xacro:unless value="${0 &lt;= sim_index and sim_index &lt; 18}">
      ${xacro.fatal('sim_index must be in [0, 17], got ' + str(sim_index))}
    </xacro:unless>
    <xacro:property name="visibility_bit" value="${1 &lt;&lt; (2 + sim_index)}"/>
    <link name="${namespace}${name}_link">
      <!-- No name: sdformat applies the <gazebo reference> visual block below only to the visual
           it calls <link>_visual. -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} ${pi} 0"/>
        <geometry>
          <mesh filename="package://minipock_description/models/lds_visual.dae"/>
        </geometry>
      </visual>
      <collision name="${name}_collision">
        <origin xyz="0 0 0.016" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://minipock_description/models/lds.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.00000542" ixy="0.0" ixz="0.0" iyy="0.00002104" iyz="0.0" izz="0.00002604"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${R} ${P} ${Y}"/>
      <parent link="${namespace}base_link"/>
      <child link="${namespace}${name}_link"/>
    </joint>
    <gazebo reference="${namespace}${name}_link">
      <visual>
        <visibility_flags>${visibility_bit}</visibility_flags>
      </visual>
      <sensor type="gpu_lidar" name="lidar">
        <update_rate>10</update_rate>
        <topic>${namespace}scan</topic>
        <gz_frame_id>${namespace}${name}_link</gz_frame_id>
        <visualize>true</visualize>
        <lidar>
          <visibility_mask>${0xFFFFFFFF - visibility_bit}</visibility_mask>
          <scan>
            <horizontal>
              <samples>132</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>6.280</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>12.0</max>
            <resolution>0.0150</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
