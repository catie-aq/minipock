<?xml version="1.0"?>
<robot name="minipock" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="minipock_base" params="namespace:=minipock/ name:=minipock x:=0 y:=0 z:=0.0">
    <link name="${namespace}base_footprint">
    </link>
    <link name="${namespace}base_link">
      <visual>
        <origin xyz="0 0 0.0" rpy="0 0 ${-pi/2}" />
        <geometry>
          <mesh filename="package://minipock_description/models/base_alu.dae" />
        </geometry>
      </visual>
      <!-- Chassis collision, from 0.0875 m below base_link (1 cm above the wheel contact plane,
           0.0975 m below base_link; the aluminium plate bottom is at -0.089) to 0.0045 m above.
           Lower, the cylinder touches the floor and its friction absorbs the small velocity
           commands of VelocityControl (holonomic). -->
      <collision>
        <origin xyz="0 0 -0.0415" rpy="0 -0 ${-pi/2}" />
        <geometry>
          <cylinder radius="0.15" length="0.092" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.0 -0.029 0.0" rpy="0 -0 0" />
        <mass value="7.587" />
        <inertia ixx="0.014" ixy="0.0" ixz="0.0" iyy="0.025" iyz="0.0" izz="0.013" />
      </inertial>
    </link>
    <link name="${namespace}minipock_structure_pla_link">
      <visual>
        <origin xyz="0 0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://minipock_description/models/base_pla.stl" />
        </geometry>
        <material name="6TRON">
          <color rgba="0.27 0.64 0.52 1.0" />
        </material>
      </visual>
    </link>
    <link name="${namespace}minipock_structure_pmma_link">
      <visual>
        <origin xyz="0 0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://minipock_description/models/base_pmma.stl" />
        </geometry>
        <material name="6TRON_2">
          <color rgba="0.27 0.64 0.52 0.9" />
        </material>
      </visual>
    </link>
    <link name="${namespace}minipock_structure_misc_link">
      <visual>
        <origin xyz="0 0 0.0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://minipock_description/models/misc.stl" />
        </geometry>
        <material name="6TRON_2">
          <color rgba="0.27 0.64 0.52 1.0" />
        </material>
      </visual>
    </link>

    <joint name="base_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <parent link="${namespace}base_footprint"/>
      <child link="${namespace}base_link"/>
    </joint>
    <joint name="minipock_structure_pla_joint" type="fixed">
      <origin xyz="0 0 0.0" rpy="0 0 ${-pi/2}"/>
      <parent link="${namespace}base_link"/>
      <child link="${namespace}minipock_structure_pla_link"/>
    </joint>
    <joint name="minipock_structure_pmma_joint" type="fixed">
      <origin xyz="0 0 0.0" rpy="0 0 ${-pi/2}"/>
      <parent link="${namespace}base_link"/>
      <child link="${namespace}minipock_structure_pmma_link"/>
    </joint>
    <joint name="minipock_structure_misc_joint" type="fixed">
      <origin xyz="0 0 0.0" rpy="0 0 ${-pi/2}"/>
      <parent link="${namespace}base_link"/>
      <child link="${namespace}minipock_structure_misc_link"/>
    </joint>
  </xacro:macro>

  <!-- Skid of the differential base: the real robot rests on its two wheels and tips onto one of
       two skids of the PLA structure, front and rear (base_pla.stl, lowest points at
       x = +-0.125 m, 0.096 m below base_link, 1.5 mm above the wheel contact plane). Modelled as
       frictionless spheres at the same height: the simulated base tips by 0.7 degree at most
       and the chassis never drags on the floor. Touching the contact plane instead, the skids
       take load off the wheels, which then slip. -->
  <xacro:macro name="caster" params="namespace:=minipock/ name:=caster_front x:=0.0">
    <xacro:property name="caster_radius" value="0.01"/>
    <link name="${namespace}${name}_link">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="${caster_radius}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.01" />
        <inertia ixx="4e-7" ixy="0.0" ixz="0.0" iyy="4e-7" iyz="0.0" izz="4e-7" />
      </inertial>
    </link>
    <joint name="${namespace}${name}_joint" type="fixed">
      <origin xyz="${x} 0 ${-0.096 + caster_radius}" rpy="0 0 0"/>
      <parent link="${namespace}base_link"/>
      <child link="${namespace}${name}_link"/>
    </joint>
    <gazebo reference="${namespace}${name}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
</robot>
