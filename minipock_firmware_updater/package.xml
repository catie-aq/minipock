<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>minipock_firmware_updater</name>
  <version>2.2.1</version>
  <description>Node for firmware update in µROS</description>
  <maintainer email="s.delpeuch@catie.fr">Sébastien Delpeuch</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pytest-cov</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
